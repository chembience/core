#!/bin/bash
set -euo pipefail

if [ "$#" -lt 1 ]; then
    echo "Usage: $0 <migration description>" >&2
    exit 2
fi

MESSAGE="$*"

if [ -f /.dockerenv ]; then
    cd /home/app/src
    exec alembic revision --autogenerate -m "$MESSAGE"
fi

if [ -z "$(docker compose ps fastapi -q 2>/dev/null)" ]; then
    echo "FastAPI container is not running. Starting it..."
    docker compose up -d fastapi
fi

exec docker compose exec -T fastapi alembic -c /home/app/src/alembic.ini \
    revision --autogenerate -m "$MESSAGE"
