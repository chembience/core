#!/bin/bash
set -euo pipefail

# Check if the FastAPI container is running (only if on host)
if [ ! -f /.dockerenv ]; then
    if [ -z "$(docker compose ps fastapi -q 2>/dev/null)" ]; then
        echo "FastAPI container is not running. Starting it..."
        docker compose up -d fastapi
    fi
fi

echo "🚀 Applying FastAPI database migrations..."
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
"${SCRIPT_DIR}/fastapi-migrate"

# --- Final info: print the web URL ---
# Load .env if present to get the connection port; fall back to defaults
if [ -f .env ]; then
  set -o allexport
  source .env
  set +o allexport
fi

FASTAPI_CONNECTION_PORT=${FASTAPI_CONNECTION_PORT:-8002}
echo
echo "🌐 FastAPI is available at: http://localhost:${FASTAPI_CONNECTION_PORT}/"
echo "   Interactive docs:       http://localhost:${FASTAPI_CONNECTION_PORT}/docs"
