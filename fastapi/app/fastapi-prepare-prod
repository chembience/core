#!/bin/bash
# Prepare a production bundle for this FastAPI app: a Docker Compose stack in
# PROD/ (--target compose, default) or SHA-pinned Helm values for a GHCR-backed
# Kubernetes deployment (--target ghcr-k8s). See PROD/README.md and
# PROD/k8s/README.md. Options: --target compose|ghcr-k8s, --keep-env-prod,
# --skip-build, --image-name NAME, --image-tag TAG.
#
# The shared implementation lives in PROD/lib/prepare-prod.sh, which the
# development container keeps in sync with this script.
set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")" && pwd)"
PREPARE_PROD_LIB=""
for candidate in "$APP_DIR/PROD/lib/prepare-prod.sh" "$APP_DIR/prod/lib/prepare-prod.sh"; do
  if [[ -f "$candidate" ]]; then
    PREPARE_PROD_LIB="$candidate"
    break
  fi
done
[[ -n "$PREPARE_PROD_LIB" ]] || {
  echo "Missing PROD/lib/prepare-prod.sh in $APP_DIR." >&2
  echo "Start the development container once (docker compose up -d) to restore it." >&2
  exit 1
}
# shellcheck source=SCRIPTDIR/../../prod-tools/lib/prepare-prod.sh
source "$PREPARE_PROD_LIB"

PREPARE_PROD_APP=fastapi
PREPARE_PROD_DISPLAY_NAME=FastAPI
PREPARE_PROD_PORT_VAR=FASTAPI_CONNECTION_PORT
PREPARE_PROD_PORT_DEFAULT=8002
PREPARE_PROD_HAS_MIGRATIONS=1

prepare_prod_verify_image() {
  echo "🔎 Verifying baked FastAPI project files..."
  docker run --rm --entrypoint /bin/sh "${IMAGE_NAME}:${IMAGE_TAG}" -c 'test -f /home/app/src/main.py'
}

prepare_prod_init_database() {
  docker compose run --rm migrate
}

prepare_prod_main "$@"
