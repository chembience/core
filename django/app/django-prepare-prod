#!/bin/bash
# Prepare a production bundle for this Django app: a Docker Compose stack in
# PROD/ (--target compose, default) or SHA-pinned Helm values for a GHCR-backed
# Kubernetes deployment (--target ghcr-k8s). See PROD/README.md and
# PROD/k8s/README.md. Options: --target compose|ghcr-k8s, --keep-env-prod,
# --skip-build, --image-name NAME, --image-tag TAG.
#
# The shared implementation lives in PROD/lib/prepare-prod.sh, which the
# development container keeps in sync with this script.
set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")" && pwd)"
PREPARE_PROD_LIB=""
for candidate in "$APP_DIR/PROD/lib/prepare-prod.sh" "$APP_DIR/prod/lib/prepare-prod.sh"; do
  if [[ -f "$candidate" ]]; then
    PREPARE_PROD_LIB="$candidate"
    break
  fi
done
[[ -n "$PREPARE_PROD_LIB" ]] || {
  echo "Missing PROD/lib/prepare-prod.sh in $APP_DIR." >&2
  echo "Start the development container once (docker compose up -d) to restore it." >&2
  exit 1
}
# shellcheck source=SCRIPTDIR/../../prod-tools/lib/prepare-prod.sh
source "$PREPARE_PROD_LIB"

PREPARE_PROD_APP=django
PREPARE_PROD_DISPLAY_NAME=Django
PREPARE_PROD_PORT_VAR=DJANGO_CONNECTION_PORT
PREPARE_PROD_PORT_DEFAULT=8001
PREPARE_PROD_HAS_MIGRATIONS=1

# CSRF trusted origins use full browser URLs, unlike DJANGO_VIRTUAL_HOSTNAME.
# Seed direct-access HTTP origins for every configured hostname; public HTTPS
# deployments should replace this in PROD/.env before starting the stack.
prepare_prod_configure_env() {
  local prod_port csrf_origins hosts default_origins host origin
  local -a host_array
  prod_port="$(get_env_var "$PROD_ENV" DJANGO_CONNECTION_PORT)"
  csrf_origins="$(get_env_var "$PROD_ENV" DJANGO_CSRF_TRUSTED_ORIGINS)"
  if [[ $KEEP_ENV_PROD -eq 0 || -z "$csrf_origins" ]]; then
    hosts="$(get_env_var "$PROD_ENV" DJANGO_VIRTUAL_HOSTNAME)"
    hosts="${hosts:-localhost}"
    default_origins=""
    IFS=',' read -r -a host_array <<< "$hosts"
    for host in "${host_array[@]}"; do
      host="${host//[[:space:]]/}"
      [[ -n "$host" && "$host" != "*" && "$host" != .* ]] || continue
      origin="http://${host}:${prod_port}"
      if [[ ",$default_origins," != *",$origin,"* ]]; then
        default_origins+="${default_origins:+,}${origin}"
      fi
    done
    set_env_var "$PROD_ENV" DJANGO_CSRF_TRUSTED_ORIGINS "$default_origins"
  fi
}

prepare_prod_verify_image() {
  echo "🔎 Verifying baked Django project files..."
  docker run --rm --entrypoint /bin/sh "${IMAGE_NAME}:${IMAGE_TAG}" -c 'test -f /home/app/src/manage.py'
}

prepare_prod_init_database() {
  docker compose run --rm migrate || return 1
  docker compose run --rm --no-deps migrate python -m chembience.django_superuser
}

prepare_prod_main "$@"
