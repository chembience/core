ARG CORE_IMAGE=chembience/core-rdkit:latest
FROM ${CORE_IMAGE}

COPY requirements.txt /opt/python/app-requirements.txt

RUN if grep -qE '^\s*[^#\s]' /opt/python/app-requirements.txt; then \
        micromamba run -n chembience python -m pip install --no-cache-dir -r /opt/python/app-requirements.txt; \
    else \
        echo "requirements.txt is empty; skipping pip install"; \
    fi && \
    micromamba clean -a -y && \
    find /opt/conda/ -follow -type f -name '*.a' -delete && \
    find /opt/conda/ -follow -type f -name '*.pyc' -delete && \
    find /opt/conda/ -follow -type f -name '*.js.map' -delete

COPY run /home/app/run
COPY shell /home/app/shell

WORKDIR /home/app
