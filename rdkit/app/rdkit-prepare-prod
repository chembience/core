#!/bin/bash
set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$APP_DIR"
PROD_DIR="$APP_DIR/PROD"
PROD_ENV="$PROD_DIR/.env"
LEGACY_PROD_ENV="$APP_DIR/.env.prod"

KEEP_ENV_PROD=0
SKIP_BUILD=0
IMAGE_TAG=""
IMAGE_NAME=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --keep-env-prod) KEEP_ENV_PROD=1; shift ;;
    --skip-build) SKIP_BUILD=1; shift ;;
    --image-name)
      [[ $# -ge 2 ]] || { echo "Missing value for --image-name" >&2; exit 2; }
      IMAGE_NAME="$2"
      shift 2
      ;;
    --image-tag)
      [[ $# -ge 2 ]] || { echo "Missing value for --image-tag" >&2; exit 2; }
      IMAGE_TAG="$2"
      shift 2
      ;;
    -*) echo "Unknown option: $1" >&2; exit 2 ;;
    *) echo "Unexpected argument: $1" >&2; exit 2 ;;
  esac
done

if [[ ! -f .env ]]; then
  echo "Missing ./.env in $APP_DIR. Aborting." >&2
  exit 1
fi

LEGACY_PROD_DIR="$(find "$APP_DIR" -maxdepth 1 -mindepth 1 -type d -name 'prod' -print -quit)"
CANONICAL_PROD_DIR="$(find "$APP_DIR" -maxdepth 1 -mindepth 1 -type d -name 'PROD' -print -quit)"
if [[ -n "$LEGACY_PROD_DIR" && -n "$CANONICAL_PROD_DIR" ]]; then
  echo "Both prod/ and PROD/ exist. Resolve the production directory manually." >&2
  exit 1
fi
if [[ -n "$LEGACY_PROD_DIR" ]]; then
  TEMP_PROD_DIR="$APP_DIR/.chembience-prod-migrate-$$"
  [[ ! -e "$TEMP_PROD_DIR" ]] || { echo "Temporary production migration path already exists: $TEMP_PROD_DIR" >&2; exit 1; }
  mv "$LEGACY_PROD_DIR" "$TEMP_PROD_DIR"
  mv "$TEMP_PROD_DIR" "$PROD_DIR"
  echo "ℹ️  Renamed legacy prod/ directory to PROD/."
fi
mkdir -p "$PROD_DIR"
MIGRATED_LEGACY_ENV=0
if [[ ! -f "$PROD_ENV" && -f "$LEGACY_PROD_ENV" ]]; then
  mv "$LEGACY_PROD_ENV" "$PROD_ENV"
  MIGRATED_LEGACY_ENV=1
  echo "ℹ️  Moved legacy .env.prod to PROD/.env."
fi

if [[ $KEEP_ENV_PROD -eq 0 && $MIGRATED_LEGACY_ENV -eq 0 ]]; then
  cp -f .env "$PROD_ENV"
fi

if grep -q '^CHEMBIENCE_RUNTIME_MODE=' "$PROD_ENV"; then
  sed -i 's/^CHEMBIENCE_RUNTIME_MODE=.*/CHEMBIENCE_RUNTIME_MODE=prod/' "$PROD_ENV"
else
  echo 'CHEMBIENCE_RUNTIME_MODE=prod' >> "$PROD_ENV"
fi

set_env_var() {
  local file="$1" key="$2" val="$3"
  if grep -q "^${key}=" "$file"; then
    sed -i "s|^${key}=.*|${key}=${val}|" "$file"
  else
    echo "${key}=${val}" >> "$file"
  fi
}

get_env_var() {
  local file="$1" key="$2"
  grep -E "^${key}=" "$file" | tail -n1 | cut -d= -f2- || true
}

if [[ -z "$IMAGE_TAG" ]]; then
  IMAGE_TAG="$(get_env_var "$PROD_ENV" CHEMBIENCE_VERSION)"
fi
if [[ -z "$IMAGE_TAG" ]]; then
  IMAGE_TAG="prod-$(date +%Y%m%d%H%M%S)"
fi

if [[ -z "$IMAGE_NAME" ]]; then
  APP_NAME_VALUE="$(get_env_var "$PROD_ENV" APP_NAME)"
  APP_NAME_VALUE="${APP_NAME_VALUE:-app}"
  [[ "$APP_NAME_VALUE" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || { echo "APP_NAME must be a valid lowercase Docker image name" >&2; exit 2; }
  IMAGE_NAME="chembience/${APP_NAME_VALUE}-prod"
fi

CORE_IMAGE_TAG="$(get_env_var .env CHEMBIENCE_VERSION)"
CORE_IMAGE_TAG="${CORE_IMAGE_TAG:-latest}"
CORE_IMAGE="chembience/core-rdkit:${CORE_IMAGE_TAG}"

if docker image inspect "${CORE_IMAGE}" >/dev/null 2>&1; then
  echo "📦 Using locally available core image: ${CORE_IMAGE}"
else
  echo "📥 Pulling required core image: ${CORE_IMAGE}..."
  docker pull "${CORE_IMAGE}"
fi

PROJECT_NAME="$(printf '%s' "$APP_NAME_VALUE" | tr '[:upper:]' '[:lower:]' | tr '.' '-')-prod"
[[ "$PROJECT_NAME" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || { echo "APP_NAME must form a valid Compose project name: $APP_NAME_VALUE" >&2; exit 2; }
set_env_var "$PROD_ENV" CHEMBIENCE_VERSION "$IMAGE_TAG"
set_env_var "$PROD_ENV" CHEMBIENCE_IMAGE_TAG "$IMAGE_TAG"
set_env_var "$PROD_ENV" CHEMBIENCE_PROD_IMAGE_NAME "$IMAGE_NAME"
set_env_var "$PROD_ENV" CHEMBIENCE_POSTGRES_IMAGE "chembience/core-rdkit-postgres:${CORE_IMAGE_TAG}"
set_env_var "$PROD_ENV" COMPOSE_PROJECT_NAME "$PROJECT_NAME"

if [[ $SKIP_BUILD -eq 0 ]]; then
  echo "📦 Building source-baked RDKit production image ${IMAGE_NAME}:${IMAGE_TAG}..."
  docker build \
    --file ./Dockerfile.prod \
    --build-arg "CORE_IMAGE=${CORE_IMAGE}" \
    --tag "${IMAGE_NAME}:${IMAGE_TAG}" \
    .
  echo "🧪 Running RDKit smoke check from produced image..."
  docker run --rm --entrypoint /opt/conda/envs/chembience/bin/python "${IMAGE_NAME}:${IMAGE_TAG}" - <<'PY'
from rdkit import Chem
print('MolFromSmiles OK:', bool(Chem.MolFromSmiles('c1ccccc1')))
PY
else
  echo "ℹ️  Skipping build and in-image verification (--skip-build)."
fi

POSTGRES_HOST_VALUE="$(get_env_var "$PROD_ENV" POSTGRES_HOST)"
if [[ "${POSTGRES_HOST_VALUE:-postgres}" == "postgres" ]]; then
  echo "🚀 Initializing the self-hosted production database..."
  (
    cd "$PROD_DIR"
    docker compose down
    docker compose up -d postgres
    for _ in {1..30}; do
      docker compose exec -T postgres sh -c 'pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_NAME"' >/dev/null 2>&1 && break
      sleep 1
    done
    docker compose exec -T postgres sh -c 'pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_NAME"' >/dev/null
    docker compose down
  )
else
  echo "ℹ️  External PostgreSQL configured; its lifecycle is managed by the database operator."
fi

echo "✅ rdkit-prepare-prod completed."
echo "ℹ️  Created image: ${IMAGE_NAME}:${IMAGE_TAG}"
echo "ℹ️  Dev environment was not changed; the prepared production stack is stopped."
