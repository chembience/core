#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
integration=false

if [[ $# -gt 1 || ${1:-} == "--help" ]]; then
  echo "Usage: ./test [--integration]" >&2
  exit 2
fi
if [[ ${1:-} == "--integration" ]]; then
  integration=true
elif [[ $# -eq 1 ]]; then
  echo "Unknown option: $1" >&2
  exit 2
fi

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Missing required command: $1" >&2
    exit 1
  }
}

require_command bash
require_command python3
require_command helm
require_command docker

cd "$root_dir"
CHEMBIENCE_VERSION="$(tr -d '[:space:]' < VERSION)"
export CHEMBIENCE_VERSION

get_env_value() {
  local file="$1" key="$2"
  sed -n "s/^${key}=//p" "$file" | tail -n 1
}

for key in CONDA_PY RDKIT_VERSION; do
  template_value="$(get_env_value .env.template "$key")"
  env_value="$(get_env_value .env "$key")"
  [[ -n "$template_value" && -n "$env_value" ]] || {
    echo "${key} must be set in both .env and .env.template" >&2
    exit 1
  }
  [[ "$env_value" == "$template_value" ]] || {
    echo "${key} differs: .env=${env_value}, .env.template=${template_value}" >&2
    exit 1
  }
done

chart_app_version="$(sed -n 's/^appVersion:[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}[[:space:]]*$/\1/p' \
  prod-tools/k8s/chart-base/Chart.yaml)"
[[ "$chart_app_version" == "$CHEMBIENCE_VERSION" ]] || {
  echo "prod-tools/k8s/chart-base/Chart.yaml appVersion differs: ${chart_app_version:-<unset>}, VERSION=${CHEMBIENCE_VERSION}" >&2
  exit 1
}
for values_file in django/app/k8s/values.yaml fastapi/app/k8s/values.yaml \
  jupyter/app/k8s/values.yaml rdkit/app/k8s/values.yaml; do
  postgres_tag="$(python3 - "$values_file" <<'PY'
import re
import sys

text = open(sys.argv[1], encoding="utf-8").read()
match = re.search(
    r"repository:\s*chembience/core-rdkit-postgres\s*,?\s*tag:\s*\"?([^\",}\s]+)",
    text,
)
print(match.group(1) if match else "")
PY
)"
  [[ "$postgres_tag" == "$CHEMBIENCE_VERSION" ]] || {
    echo "${values_file} core-rdkit-postgres tag differs: ${postgres_tag:-<unset>}, VERSION=${CHEMBIENCE_VERSION}" >&2
    exit 1
  }
done

bash -n django/app/*-configure django/app/*-prepare-prod \
  fastapi/app/*-configure fastapi/app/*-prepare-prod \
  jupyter/app/*-configure jupyter/app/*-prepare-prod \
  rdkit/app/*-configure rdkit/app/*-prepare-prod \
  prod-tools/lib/prepare-prod.sh share/entrypoint/helpers.sh */docker-entrypoint.sh \
  tests/test-prod-env-workflow.sh
if command -v shellcheck >/dev/null 2>&1; then
  mapfile -t shell_files < <(
    git ls-files -z | while IFS= read -r -d '' file; do
      [[ -f "$file" && "$file" != test-builds/* ]] || continue
      if [[ "$file" == *.sh ]] || head -n 1 "$file" | grep -qE '^#!.*\b(ba)?sh\b'; then
        printf '%s\n' "$file"
      fi
    done
  )
  shellcheck -S warning -e SC1091 "${shell_files[@]}"
else
  echo "ℹ️  shellcheck not installed; skipping local shell lint (CI still runs it)."
fi
python3 -m unittest share.tests.test_django_superuser
bash tests/test-prod-env-workflow.sh
bash prod-tools/k8s/tests/render.sh
docker compose --env-file .env.template -f docker-compose.yml config --quiet
docker compose --env-file .env.template -f docker-compose.yml -f docker-compose.dev.yml config --quiet

if [[ "$integration" == true ]]; then
  bash tests/test-integration.sh
fi

echo "✅ Chembience tests passed."
