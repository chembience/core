#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

[[ -f .env ]] || { echo "Missing PROD/.env." >&2; exit 1; }
set -o allexport
source .env
set +o allexport

docker compose exec -e "PGPASSWORD=${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD in .env}" postgres \
  psql -p "${POSTGRES_INTERNAL_PORT:-5432}" -U "${POSTGRES_USER:-chembience}" -d "${POSTGRES_NAME:-chembience}" "$@"
