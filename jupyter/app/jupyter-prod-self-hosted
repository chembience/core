#!/bin/bash
set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$APP_DIR"

if [[ "${1:-}" == "--skip-prepare" && $# -eq 1 ]]; then
  [[ -f PROD/.env ]] || { echo "Missing PROD/.env; run ./jupyter-prepare-prod first." >&2; exit 1; }
elif [[ $# -eq 0 ]]; then
  if [[ -f PROD/.env ]]; then ./jupyter-prepare-prod --keep-env-prod; else ./jupyter-prepare-prod; fi
else
  echo "Usage: $0 [--skip-prepare]" >&2; exit 2
fi

get_env_var() { grep -E "^$2=" "$1" | tail -n1 | cut -d= -f2- || true; }
cd PROD
PROJECT_NAME="$(get_env_var .env COMPOSE_PROJECT_NAME)"
echo "🚀 Starting self-hosted Jupyter production stack as ${PROJECT_NAME}..."
docker compose up -d
PORT="$(get_env_var .env JUPYTER_CONNECTION_PORT)"
echo "✅ Jupyter production is available at http://localhost:${PORT:-9888}/"
